# AAE Environment Configuration Template
# Copy this file to .env and configure local development values.
# NEVER commit .env to source control.

# Application Environment: development | testing | production
AAE_ENVIRONMENT=development
AAE_DEBUG=true
AAE_APP_NAME="AI Automation Engineer"
AAE_APP_VERSION=0.1.0

# Server Binding
AAE_HOST=127.0.0.1
AAE_PORT=8000

# Security
# Secret key used for signing and internal token verification (change in production!)
AAE_SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_chars

# Database (PostgreSQL required for runtime)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
AAE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aae_dev
AAE_DB_POOL_SIZE=5
AAE_DB_MAX_OVERFLOW=10
AAE_DB_TIMEOUT_SECONDS=5

# n8n Provider Configuration
AAE_N8N_URL=http://localhost:5678
AAE_N8N_API_KEY=
AAE_N8N_TIMEOUT_SECONDS=10
AAE_N8N_VERIFY_SSL=true

# Logging
# Log Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
AAE_LOG_LEVEL=INFO
AAE_LOG_FORMAT=json
